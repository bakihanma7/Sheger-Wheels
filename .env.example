# Only PUBLIC, non-secret values belong in NEXT_PUBLIC_* variables. Never put secrets here.

# Canonical site URL used for metadataBase, sitemap, robots and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "false" in production to hide the "Reset demo data (dev)" button in the demo banner.
NEXT_PUBLIC_SHOW_RESET=true
